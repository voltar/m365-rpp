{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.27/MicrosoftTeams.schema.json",
  "version": "4.0.9",
  "manifestVersion": "1.27",
  "id": "00000000-0000-0000-0000-000000000011",
  "name": {
    "short": "RPP BetaV2",
    "full": "RPP BetaV2 — Host Europe (rpp.example.com)"
  },
  "developer": {
    "name": "Voltar",
    "websiteUrl": "https://rpp.example.com",
    "privacyUrl": "https://example.com/privacy",
    "termsOfUseUrl": "https://example.com/terms"
  },
  "description": {
    "short": "RPP 4.0.9 Friends & Family on Host Europe",
    "full": "Sideload package for https://rpp.example.com (Kestrel + PostgreSQL), release 4.0.9 Friends & Family final. Display name RPP BetaV2. Own Entra app (RPP Example); separate Teams app id for side-by-side install with Azure RC."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#6264A7",
  "staticTabs": [
    {
      "entityId": "rpp-planning",
      "name": "RPP BetaV2",
      "contentUrl": "https://rpp.example.com",
      "websiteUrl": "https://rpp.example.com",
      "scopes": [
        "personal",
        "team"
      ]
    }
  ],
  "validDomains": [
    "rpp.example.com"
  ],
  "webApplicationInfo": {
    "id": "00000000-0000-0000-0000-000000000003",
    "resource": "api://rpp.example.com/00000000-0000-0000-0000-000000000003"
  },
  "localizationInfo": {
    "defaultLanguageTag": "en-us",
    "additionalLanguages": [
      { "languageTag": "de-de", "file": "de-de.json" },
      { "languageTag": "de-ch", "file": "de-ch.json" },
      { "languageTag": "zh-cn", "file": "zh-cn.json" },
      { "languageTag": "es-es", "file": "es-es.json" },
      { "languageTag": "fr-fr", "file": "fr-fr.json" },
      { "languageTag": "it-it", "file": "it-it.json" },
      { "languageTag": "pt-pt", "file": "pt-pt.json" },
      { "languageTag": "ru-ru", "file": "ru-ru.json" }
    ]
  },
  "showLoadingIndicator": true,
  "isFullScreen": true,
  "configurableProperties": [
    "name",
    "shortDescription",
    "longDescription",
    "smallImageUrl",
    "largeImageUrl",
    "accentColor",
    "privacyUrl",
    "termsOfUseUrl"
  ],
  "publisherDocsUrl": "https://example.com/docs",
  "supportsChannelFeatures": "tier1"
}
